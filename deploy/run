#!/usr/bin/env node

/**
 * @file Manage to derive the DATABASE_URL env var
 * into several ones, followed by starting the correct npm script.
 * It will set the new vars prepending its declaration prior
 * calling the npm-script defined by the caller.
 * The main intent is to solve the problem when the cloud provider changes
 * the DATABASE_URL due to maintenance that leads to manual derivation
 * of such values.
 *
 * @author Bruno Menezes <brunodmenezes@gmail.com>
 */

/**
 * @typedef {Object} Config
 * @property {string} DB_HOST - Database host
 * @property {string} DB_NAME - Database name
 * @property {string} DB_USER - Database user
 * @property {string} DB_PASS - Database password
 * @property {string} DB_PORT - Database port
 */

const url = require('node:url');
const { spawn } = require('node:child_process');
const yargs = require('yargs');
const { hideBin } = require('yargs/helpers');

const argv = yargs(hideBin(process.argv))
    .usage('Usage: $0 --npmScriptName=<script> [-- <script arguments>]')
    .parserConfiguration({ 'populate--': true })
    .hide('version')
    .hide('help')
    .option('npmScriptName', {
        type: 'string',
        demandOption: true,
        describe: 'Npm script to execute.',
    })
    .example(
        '$0 --npmScriptName=sqd -- process:prod',
        'Runs: npm run sqd -- process:prod',
    )
    .epilog(
        'Arguments after "--" are forwarded unchanged to the selected npm script.',
    )
    .strict()
    .parse();

if (!argv.npmScriptName) {
    console.error('Npm script name is required!\n');
    process.exit(1);
}

const scriptName = argv.npmScriptName;
const scriptArgs = argv['--'] || [];
const DATABASE_URL = process.env.DATABASE_URL;

/**
 *
 * @param {string} databaseUrl PostgreSQL connection URL.
 * @return {Config}
 */
function deriveConfig(databaseUrl) {
    if (!url.URL.canParse(databaseUrl)) {
        throw new Error('DATABASE_URL is not a valid URL!');
    }

    if (!databaseUrl) {
        throw new Error('DATABASE_URL is required!');
    }

    const db = new url.URL(databaseUrl);

    const databaseName = decodeURIComponent(db.pathname.slice(1));

    if (!db.hostname || !databaseName || !db.username) {
        throw new Error(
            'DATABASE_URL must include host, database name, and username.',
        );
    }

    return {
        DB_HOST: db.hostname,
        DB_NAME: databaseName,
        DB_USER: decodeURIComponent(db.username),
        DB_PASS: decodeURIComponent(db.password),
        DB_PORT: db.port,
    };
}

/**
 *
 * @param {{scriptName: string, args: string[]}} scriptOpt Existing npm-script name and arguments.
 * @param {Config} config Database environment variables to be injected.
 */
function runScript(scriptOpt, config) {
    const child = spawn(
        'npm',
        ['run', scriptOpt.scriptName, '--', ...scriptOpt.args],
        {
            env: {
                ...process.env,
                ...config,
            },
            stdio: 'inherit',
        },
    );

    child.on('exit', (code, signal) => {
        if (signal) {
            process.kill(process.pid, signal);
        } else {
            process.exit(code ?? 1);
        }
    });
}

runScript({ scriptName, args: scriptArgs }, deriveConfig(DATABASE_URL));
